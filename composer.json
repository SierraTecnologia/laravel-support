{
    "name": "sierratecnologia/laravel-support",
    "description": "SierraTecnologia common support helpers, contracts, and traits required by various SierraTecnologia packages. Validator functionality, and basic controller included out-of-the-box.",
    "type": "library",
    "keywords": [
        "sierratecnologia",
        "laravel",
        "contract",
        "validator",
        "timezones",
        "mimetype",
        "support",
        "helper",
        "trait"
    ],
    "license": "MIT",
    "homepage": "https://sierratecnologia.com/packages/laravel-support/",
    "support": {
        "email": "help@sierratecnologia.com",
        "issues": "https://github.com/sierratecnologia/laravel-support/issues",
        "source": "https://github.com/sierratecnologia/laravel-support",
        "docs": "https://github.com/sierratecnologia/laravel-support/blob/master/README.md"
    },
    "authors": [
        {
            "name": "SierraTecnologia",
            "homepage": "https://sierratecnologia.com.br",
            "email": "help@sierratecnologia.com.br"
        }
    ],
    "require": {
        "php": "^8.3",
        "sierratecnologia/templeiro": "^2.0",
        "sierratecnologia/pedreiro": "^2.0",
        "sierratecnologia/crypto": "^2.0",
        "sierratecnologia/muleta": "^2.0",
        "ricardosierra/library": "^2.0",
        "cviebrock/eloquent-sluggable": "^13.0",
        "league/plates": "^3.6",
        "doctrine/orm": "^3.7",
        "laravel/tinker": "^3.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/auth": "^13.0",
        "illuminate/bus": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "laravel/framework": "^13.0",
        "doctrine/dbal": "^4.4",
        "league/flysystem": "^3.36",
        "jenssegers/agent": "^2.6",
        "league/fractal": "^0.20",
        "guzzlehttp/guzzle": "^7.10",
        "league/pipeline": "^1.1",
        "spatie/laravel-backup": "^10.3",
        "laravel/passport": "^13.8",
        "sabre/xml": "^4.1",
        "spatie/eloquent-sortable": "^5.0",
        "spatie/laravel-schemaless-attributes": "^2.6",
        "spatie/laravel-sluggable": "^4.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "barryvdh/laravel-ide-helper": "^3.7",
        "friendsofphp/php-cs-fixer": "^3.68",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^13.0"
    },
    "suggest": {
        "hieu-le/active": "^7.0 || ^8.0",
        "prettus/l5-repository": "*",
        "elasticquent/elasticquent": "^1.0",
        "bkwld/cloner": "^3.0",
        "phoenix-lib/elasticsearch-model": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Support\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Support\\Tests\\": "tests"
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Support\\SupportServiceProvider"
            ],
            "aliases": {
                "Support": "Support\\Facades\\Support"
            }
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../**",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "2.3.0"
}
